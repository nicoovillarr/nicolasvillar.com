---
import Layout from "../Layout.astro";
import PostCard from "../PostCard.astro";
import { SITE_TITLE } from "../../consts";
import { getLang, useTranslations } from "../../i18n/ui";
import { getVisiblePosts, postSlug } from "../../utils/posts";
import { readingTime } from "../../utils/readingTime";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const posts = await getVisiblePosts(lang);
const description = t("blog.description");
---

<Layout title={`Blog | ${SITE_TITLE}`} description={description}>
  <main class="content">
    <section class="mb-16 pb-8 border-b border-gray-300 dark:border-gray-700">
      <h1 class="mb-4 text-5xl md:text-6xl font-normal">Blog</h1>
      <p class="text-muted">{description}</p>
    </section>

    <section class="space-y-12">
      {
        posts.map((post) => (
          <PostCard
            slug={postSlug(post)}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            minutesToRead={readingTime(post.body)}
          />
        ))
      }
    </section>
  </main>
</Layout>
