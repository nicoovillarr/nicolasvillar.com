---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import TagBox from "./TagBox.astro";
import Prose from "./Prose.astro";
import { getLang, useTranslations } from "../i18n/ui";

type Props = CollectionEntry<"blog">["data"] & { minutesToRead: number };
const { title, description, category, minutesToRead, pubDate, updatedDate, tags } =
  Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---

<article class="content">
  <header class="mb-12 pb-12 border-b border-gray-300 dark:border-gray-700">
    <aside class="flex text-muted mb-2">
      <FormattedDate date={pubDate} />
      <span class="mx-2">•</span>
      <span>{minutesToRead} {t("blog.minutesToRead")}</span>
    </aside>

    <Prose>
      <h1>{title}</h1>

      <p class="description text-muted">{description}</p>

      {
        updatedDate && updatedDate.getTime() !== pubDate.getTime() ? (
          <p class="text-sm text-muted mt-2">
            {t("blog.lastUpdated")} <FormattedDate date={updatedDate} />
          </p>
        ) : null
      }
    </Prose>

    <aside class="flex flex-wrap gap-2 mt-8">
      {category && <TagBox tag={category} isPrimary={true} />}
      {tags
        ?.filter((tag) => tag !== category)
        .map((tag) => <TagBox tag={tag} />)}
    </aside>
  </header>
  <Prose>
    <slot />
  </Prose>
</article>
