---
interface Props {
  tag: string;
  isPrimary?: boolean;
}

const { tag, isPrimary = false } = Astro.props as Props;
---

<span
  class={`${
    isPrimary
      ? "bg-gray-800 text-white border border-gray-800 dark:bg-gray-100 dark:text-gray-900 dark:border-gray-100"
      : "bg-gray-50 text-gray-800 border border-gray-800 dark:bg-gray-900 dark:text-gray-200 dark:border-gray-400"
  } text-sm font-medium px-3 py-2 rounded-[1px]`}
>
  {tag}
</span>
