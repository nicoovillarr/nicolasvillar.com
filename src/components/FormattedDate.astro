---
import { getLang, htmlLang } from "../i18n/ui";

interface Props {
  date: Date;
}

const { date } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(htmlLang[lang], {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "UTC",
    })
  }
</time>
