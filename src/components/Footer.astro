---
import FooterLinks from "./FooterLinks.astro";
---

<footer class="border-t border-gray-400 py-8">
  <div class="mx-auto content h-full flex justify-between gap-x-4">
    <div>
      <p class="text-sm text-gray-600">
        © {new Date().getFullYear()} Nicolás Villar. Algunos derechos reservados.
      </p>
      <a
        href="mailto:nicolasvillar00@gmail.com"
        class="text-sm text-gray-600 hover:underline"
      >
        nicolasvillar00@gmail.com
      </a>
    </div>

    <FooterLinks
      title="Links"
      links={[
        { text: "Inicio", href: "/" },
        { text: "Blog", href: "/blog" },
        { text: "Contacto", href: "/contacto" },
      ]}
    />

    <FooterLinks
      title="Redes Sociales"
      links={[
        { text: "GitHub", href: "https://github.com/nicoovillarr" },
        {
          text: "LinkedIn",
          href: "https://www.linkedin.com/in/nicol%C3%A1s-villar/",
        },
      ]}
    />
  </div>
</footer>
