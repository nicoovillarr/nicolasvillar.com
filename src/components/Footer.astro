---
import { CONTACT_EMAIL } from "../consts";
import FooterLinks from "./FooterLinks.astro";
---

<footer class="border-t border-gray-300 py-8 dark:border-gray-700">
  <div class="content h-full flex flex-wrap justify-between gap-x-4 gap-y-6">
    <div>
      <p class="text-sm text-muted">
        © {new Date().getFullYear()} Nicolás Villar. Todos los derechos reservados.
      </p>
      <p class="mt-2 flex gap-x-4 text-sm">
        <a
          href="/privacidad"
          class="text-gray-600 hover:text-gray-900 hover:underline dark:text-gray-400 dark:hover:text-gray-100"
          >Privacidad</a
        >
        <button
          type="button"
          data-cookie-preferences
          class="cursor-pointer text-gray-600 hover:text-gray-900 hover:underline dark:text-gray-400 dark:hover:text-gray-100"
        >
          Cookies
        </button>
      </p>
    </div>

    <FooterLinks
      title="Links"
      links={[
        { text: "Inicio", href: "/" },
        { text: "Blog", href: "/blog" },
        { text: "Contacto", href: "/#contact" },
      ]}
    />

    <FooterLinks
      title="Contactame"
      links={[
        { text: "GitHub", href: "https://github.com/nicoovillarr" },
        {
          text: "LinkedIn",
          href: "https://www.linkedin.com/in/nicol%C3%A1s-villar/",
        },
        { text: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` },
      ]}
    />
  </div>
</footer>
