---
interface Props {
  label: string;
  name: string;
  options: string[] | { value: string; displayText: string }[];
  placeholder?: string;
  required?: boolean;
}

const {
  label,
  name,
  options,
  placeholder = "Selecciona una opción...",
  required = false,
}: Props = Astro.props;

const isObjectOptions = typeof options[0] === "object";
const parsedOptions = isObjectOptions
  ? (options as { value: string; displayText: string }[])
  : (options as string[]).map((opt) => ({ value: opt, displayText: opt }));
---

<div class="flex flex-col">
  <label for={name} class="mb-1 font-medium"
    >{label}<span class="text-red-500">*</span></label
  >
  <select
    id={name}
    name={name}
    class="border border-gray-300 rounded-md p-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
    required
  >
    <option value="" disabled selected>{placeholder}</option>
    {
      parsedOptions.map((opt) => (
        <option value={opt.value}>{opt.displayText}</option>
      ))
    }
  </select>
</div>
