---
import { subjects } from "../consts";
import Input from "./Input.astro";
import Select from "./Select.astro";
import { getLang, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const subjectOptions = Object.entries(subjects).map(([value, label]) => ({
  value,
  displayText: label[lang],
}));

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section id="contact">
  <h2 class="text-3xl font-semibold mb-6">{t("contact.title")}</h2>

  <form
    id="contact-form"
    class="flex flex-col gap-y-2"
    data-sending={t("contact.sending")}
    data-success={t("contact.success")}
    data-try-again={t("contact.tryAgain")}
    data-error={t("contact.error")}
    data-offline={t("contact.offline")}
  >
    <input type="hidden" name="lang" value={lang} />

    <Input
      label={t("contact.name")}
      name="name"
      placeholder={t("contact.namePlaceholder")}
      required
    />

    <Input
      label={t("contact.email")}
      type="email"
      name="email"
      placeholder={t("contact.emailPlaceholder")}
      required
    />

    <Select
      label={t("contact.subject")}
      name="subject"
      options={subjectOptions}
      placeholder={t("contact.subjectPlaceholder")}
      required
    />

    <Input
      label={t("contact.message")}
      type="multiline"
      name="message"
      placeholder={t("contact.messagePlaceholder")}
      maxLength={500}
      required
    />

    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="website">Website</label>
      <input
        type="text"
        id="website"
        name="website"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    {
      turnstileSiteKey && (
        <div
          class="cf-turnstile mt-2 ml-auto"
          data-sitekey={turnstileSiteKey}
          data-language={lang}
        />
      )
    }

    <button
      id="submit-button"
      type="submit"
      class="mt-4 w-fit ml-auto bg-linear-to-br from-gray-800 to-gray-700 px-8 py-3 rounded-lg text-white cursor-pointer hover:opacity-90 disabled:cursor-wait disabled:opacity-60 dark:from-gray-100 dark:to-gray-300 dark:text-gray-900"
    >
      {t("contact.submit")}
    </button>

    <p id="status-msg" class="text-sm ml-auto hidden"></p>
  </form>
</section>

{
  turnstileSiteKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  type TurnstileWindow = Window & { turnstile?: { reset: () => void } };

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const statusMsg = document.getElementById("status-msg") as HTMLElement;
  const submitButton = document.getElementById(
    "submit-button"
  ) as HTMLButtonElement;

  const showStatus = (text: string) => {
    statusMsg.textContent = text;
    statusMsg.classList.remove("hidden");
  };

  const readErrorMessage = async (response: Response) => {
    try {
      const body = await response.json();
      return typeof body?.message === "string" ? body.message : null;
    } catch {
      return null;
    }
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (submitButton.disabled) {
      return;
    }

    const data = Object.fromEntries(new FormData(form));
    const messages = form.dataset;

    submitButton.disabled = true;
    showStatus(messages.sending!);

    try {
      const response = await fetch("/api/send-email", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        showStatus(messages.success!);
        form.reset();
        form
          .querySelectorAll("input, textarea")
          .forEach((field) => field.dispatchEvent(new Event("input")));
      } else {
        const errorMessage = await readErrorMessage(response);
        showStatus(
          errorMessage
            ? `${errorMessage}. ${messages.tryAgain}`
            : messages.error!
        );
      }
    } catch {
      showStatus(messages.offline!);
    } finally {
      submitButton.disabled = false;
      (window as TurnstileWindow).turnstile?.reset();
    }
  });
</script>
