---
import { GA_MEASUREMENT_ID } from "../consts";
import { getLang, localizePath, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section
  id="cookie-consent"
  data-measurement-id={GA_MEASUREMENT_ID}
  data-status-granted={t("cookies.statusGranted")}
  data-status-denied={t("cookies.statusDenied")}
  data-status-pending={t("cookies.statusPending")}
  aria-label={t("cookies.label")}
  class="fixed inset-x-4 bottom-4 z-50 mx-auto hidden max-w-xl rounded-lg border border-gray-300 bg-white p-5 shadow-2xl dark:border-gray-700 dark:bg-gray-900"
>
  <p class="text-base">
    {t("cookies.message")}
    <a
      href={localizePath(lang, "/privacy")}
      class="text-blue-700 hover:underline dark:text-blue-400"
      >{t("cookies.moreInfo")}</a
    >.
  </p>
  <div class="mt-4 flex justify-end gap-3">
    <button
      type="button"
      data-consent="denied"
      class="cursor-pointer rounded-lg border border-gray-400 px-5 py-2 hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-800"
    >
      {t("cookies.reject")}
    </button>
    <button
      type="button"
      data-consent="granted"
      class="cursor-pointer rounded-lg bg-gray-800 px-5 py-2 text-white hover:opacity-90 dark:bg-gray-100 dark:text-gray-900"
    >
      {t("cookies.accept")}
    </button>
  </div>
</section>

<script>
  type Consent = "granted" | "denied";
  type AnalyticsWindow = Window & {
    dataLayer?: unknown[];
    [key: `ga-disable-${string}`]: boolean;
  };

  const STORAGE_KEY = "analytics-consent";
  const banner = document.getElementById("cookie-consent") as HTMLElement;
  const STATUS_LABELS: Record<Consent | "pending", string> = {
    granted: banner.dataset.statusGranted!,
    denied: banner.dataset.statusDenied!,
    pending: banner.dataset.statusPending!,
  };
  const measurementId = banner.dataset.measurementId!;
  const analyticsWindow = window as AnalyticsWindow;

  const readConsent = (): Consent | null => {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === "granted" || value === "denied" ? value : null;
    } catch {
      return null;
    }
  };

  const saveConsent = (consent: Consent) => {
    try {
      localStorage.setItem(STORAGE_KEY, consent);
    } catch {
      return;
    }
  };

  const loadAnalytics = () => {
    analyticsWindow[`ga-disable-${measurementId}`] = false;

    if (analyticsWindow.dataLayer) {
      return;
    }

    analyticsWindow.dataLayer = [];
    function gtag(..._args: unknown[]) {
      analyticsWindow.dataLayer!.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", measurementId);

    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    document.head.appendChild(script);
  };

  const removeAnalyticsCookies = () => {
    analyticsWindow[`ga-disable-${measurementId}`] = true;

    const domains = [location.hostname, `.${location.hostname.replace(/^www\./, "")}`];
    document.cookie
      .split(";")
      .map((cookie) => cookie.split("=")[0].trim())
      .filter((name) => name.startsWith("_ga"))
      .forEach((name) => {
        domains.forEach((domain) => {
          document.cookie = `${name}=; Max-Age=0; path=/; domain=${domain}`;
        });
        document.cookie = `${name}=; Max-Age=0; path=/`;
      });
  };

  const applyConsent = (consent: Consent) => {
    if (consent === "granted") {
      loadAnalytics();
    } else {
      removeAnalyticsCookies();
    }
  };

  const renderStatus = (consent: Consent | null) => {
    document
      .querySelectorAll<HTMLElement>("[data-consent-status]")
      .forEach((status) => {
        status.textContent = STATUS_LABELS[consent ?? "pending"];
      });

    document
      .querySelectorAll<HTMLButtonElement>("[data-consent-controls] [data-consent]")
      .forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.consent === consent)
        );
      });
  };

  document.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((button) =>
    button.addEventListener("click", () => {
      const consent = button.dataset.consent as Consent;
      saveConsent(consent);
      applyConsent(consent);
      renderStatus(consent);
      banner.classList.add("hidden");
    })
  );

  const storedConsent = readConsent();
  renderStatus(storedConsent);

  if (storedConsent) {
    applyConsent(storedConsent);
  } else {
    banner.classList.remove("hidden");
  }
</script>
