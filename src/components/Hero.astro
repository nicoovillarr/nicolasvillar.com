---
import { Image } from "astro:assets";
import Me from "../assets/yo2.webp";
---

<section class="flex flex-col items-start gap-8 md:flex-row">
  <Image
    src={Me}
    alt="Foto de Nicolás Villar"
    widths={[320, 480, 640]}
    sizes="(min-width: 768px) 256px, calc(100vw - 2rem)"
    loading="eager"
    fetchpriority="high"
    class="w-full max-h-80 md:w-1/3 md:h-auto shrink-0 aspect-square rounded-md object-cover shadow-2xl"
  />

  <div class="flex flex-col justify-center gap-y-4">
    <h1 class="text-4xl font-bold">Nicolás Villar</h1>
    <p class="text-lg">
      Desarrollador full stack senior con 6 años de experiencia y debilidad por
      el diseño limpio y la arquitectura robusta. Actualmente construyo sistemas
      para clientes de Estados Unidos en Kaizen Softworks, y por mi cuenta
      experimento con nuevas tecnologías.
    </p>
    <p class="text-lg">
      Cuando no estoy programando, me gusta tocar el piano y mirar series en
      Netflix.
    </p>
    <p class="ml-auto text-muted italic w-fit whitespace-nowrap">
      Montevideo, Uruguay
    </p>
  </div>
</section>
