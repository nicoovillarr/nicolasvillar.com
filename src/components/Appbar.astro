---
import Me from "../assets/yo2.webp";
---

<header class="border-b border-gray-400">
  <div class="mx-auto content">
    <nav class="flex h-20 items-center justify-between">
      <a href="/" class="text-2xl">
        <img
          src={Me.src}
          alt="Nicolás Villar"
          class="h-10 w-10 rounded-md object-cover"
        />
      </a>
      <div class="space-x-4">
        <a href="/blog" class="text-lg text-gray-600 hover:text-gray-900"
          >Blog</a
        >
        <a href="/about" class="text-lg text-gray-600 hover:text-gray-900"
          >Sobre mí</a
        >
        <a href="/contact" class="text-lg text-gray-600 hover:text-gray-900"
          >Contacto</a
        >
      </div>
    </nav>
  </div>
</header>
