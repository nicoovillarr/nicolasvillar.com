---
import { Image } from "astro:assets";
import Me from "../assets/yo2.webp";
import {
  getLang,
  localizePath,
  otherLang,
  switchLanguagePath,
  useTranslations,
  type Localized,
} from "../i18n/ui";

interface Props {
  alternatePaths?: Localized<string>;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const alternateLang = otherLang(lang);
const alternatePath =
  Astro.props.alternatePaths?.[alternateLang] ??
  switchLanguagePath(Astro.url.pathname, alternateLang);
---

<header class="border-b border-gray-300 dark:border-gray-700">
  <div class="content">
    <nav class="flex h-20 items-center justify-between">
      <a
        href={localizePath(lang)}
        class="text-xl font-semibold flex items-center gap-x-3 text-gray-900 dark:text-gray-100"
      >
        <Image
          src={Me}
          alt="Nicolás Villar"
          width={40}
          height={40}
          densities={[1, 2]}
          loading="eager"
          class="h-10 w-10 rounded-md object-cover"
        />
        Nikein
      </a>
      <div class="flex items-center gap-x-4">
        <a
          href={localizePath(lang, "/blog")}
          class="text-lg text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
          >Blog</a
        >
        <a
          href={localizePath(lang, "/#contact")}
          class="text-lg text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100"
          >{t("nav.contact")}</a
        >
        <a
          href={alternatePath}
          hreflang={alternateLang}
          lang={alternateLang}
          aria-label={t("nav.switchLanguage")}
          title={t("nav.switchLanguage")}
          class="rounded-sm border border-gray-400 px-2 py-0.5 text-sm font-medium uppercase text-gray-600 hover:border-gray-900 hover:text-gray-900 dark:border-gray-600 dark:text-gray-400 dark:hover:border-gray-100 dark:hover:text-gray-100"
          >{alternateLang}</a
        >
      </div>
    </nav>
  </div>
</header>
