---
interface Props {
  label: string;
  type?: "text" | "email" | "password" | "number" | "multiline";
  name: string;
  placeholder?: string;
  required?: boolean;
  maxLength?: number;
}

const {
  label,
  type = "text",
  name,
  placeholder = "",
  required = false,
  maxLength,
}: Props = Astro.props;
---

<div class="flex flex-col">
  <label for={name} class="mb-1 font-medium"
    >{label}{required && <span class="text-red-500">*</span>}</label
  >
  {
    type === "multiline" ? (
      <textarea
        id={name}
        name={name}
        placeholder={placeholder}
        class="border border-gray-300 rounded-md p-2 resize-none focus:outline-none focus:ring-2 focus:ring-blue-500"
        rows="4"
        required={required}
      />
    ) : (
      <input
        type={type}
        id={name}
        name={name}
        placeholder={placeholder}
        class="border border-gray-300 rounded-md p-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 dark:border-gray-700 dark:bg-gray-900"
        required={required}
      />
    )
  }
  {
    maxLength ? (
      <p id={`${name}-maxLength`} class="text-sm text-muted mt-1 ml-auto" />
    ) : null
  }
</div>

<script define:vars={{ name, maxLength }}>
  const inputElement = document.getElementById(name);

  if (maxLength) {
    const maxLengthMsg = document.getElementById(`${name}-maxLength`);
    if (maxLengthMsg) {
      maxLengthMsg.textContent = `${0}/${maxLength}`;
      inputElement?.addEventListener("input", () => {
        const currentLength = inputElement.value.length;

        if (currentLength > maxLength) {
          inputElement.value = inputElement.value.slice(0, maxLength);
        }

        if (maxLengthMsg) {
          maxLengthMsg.textContent = `${inputElement.value.length}/${maxLength}`;
        }
      });
    }
  }
</script>
