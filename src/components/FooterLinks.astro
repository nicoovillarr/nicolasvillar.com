---
interface Props {
  title: string;
  links: { text: string; href: string }[];
}

const { title, links } = Astro.props;
---

<article>
  <h3 class="font-semibold mb-2">{title}</h3>
  <ul class="space-y-1">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm text-gray-600 hover:text-gray-900 hover:underline transition-colors duration-200"
          >
            {link.text}
          </a>
        </li>
      ))
    }
  </ul>
</article>
