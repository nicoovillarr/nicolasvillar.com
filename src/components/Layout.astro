---
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "@fontsource/newsreader/600.css";
import "@fontsource/newsreader/700.css";
import "../styles/global.css";
import Appbar from "./Appbar.astro";
import Footer from "./Footer.astro";
import BaseHead, { type Article } from "./BaseHead.astro";
import CookieConsent from "./CookieConsent.astro";
import { getLang, htmlLang, type Localized } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: Article;
  alternatePaths?: Localized<string>;
}

const { title, description, image, article, alternatePaths } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

<html lang={htmlLang[lang]}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
      alternatePaths={alternatePaths}
    />
  </head>
  <body class="min-h-screen grid grid-rows-[auto_1fr_auto] gap-8">
    <Appbar alternatePaths={alternatePaths} />
    <slot />
    <Footer />
    <CookieConsent />
  </body>
</html>
