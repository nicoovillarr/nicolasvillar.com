---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  status?: string;
  stack: string[];
  links: { text: string; href: string }[];
}

const { title, description, image, status, stack, links } = Astro.props;

const isExternal = (href: string) => href.startsWith("http");
---

<article class="flex flex-col gap-5 sm:flex-row sm:items-start">
  <Image
    src={image}
    alt={`Logo de ${title}`}
    width={128}
    height={128}
    densities={[1, 2]}
    class="w-24 h-24 sm:w-32 sm:h-32 shrink-0 object-cover rounded-md border border-gray-200 bg-white p-2 dark:border-gray-700"
  />

  <div class="flex flex-col gap-y-2">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <h3 class="text-2xl font-semibold">{title}</h3>
      {
        status && (
          <span class="rounded-sm bg-gray-800 px-2 py-0.5 text-xs font-medium uppercase tracking-wide text-white dark:bg-gray-100 dark:text-gray-900">
            {status}
          </span>
        )
      }
    </div>
    <p class="text-lg">{description}</p>

    {
      stack.length > 0 && (
        <ul class="flex flex-wrap gap-2 text-sm text-muted">
          {stack.map((technology) => (
            <li class="rounded-sm border border-gray-300 px-2 py-0.5 dark:border-gray-700">
              {technology}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-1 flex flex-wrap gap-x-5">
      {
        links.map((link) => (
          <a
            href={link.href}
            {...(isExternal(link.href)
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
            class="text-blue-700 hover:text-blue-900 hover:underline dark:text-blue-400 dark:hover:text-blue-300"
          >
            {link.text} →
          </a>
        ))
      }
    </div>
  </div>
</article>
