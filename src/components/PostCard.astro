---
import FormattedDate from "./FormattedDate.astro";

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  timeToRead: number;
  filePath: string;
}

const { id, title, description, pubDate, category, timeToRead, filePath } =
  Astro.props as Props;

const url = `/blog/${id}`;
---

<article class="flex flex-col space-y-2">
  <aside class="flex items-center gap-x-2 text-muted font-thin text-sm">
    <FormattedDate date={pubDate} />
    •
    <span>{category}</span>
    •
    <span>{timeToRead} min</span>
  </aside>

  <a
    href={url}
    class="relative w-fit text-2xl text-gray-700
    hover:text-gray-950
      transition-colors duration-200"
  >
    {title}
  </a>

  <p class="text-muted mt-2 line-clamp-2">{description}</p>

  <a
    href={url}
    class="w-fit text-gray-500 hover:text-gray-900 mt-4 transition-colors duration-200"
  >
    <h4>Leer más →</h4>
  </a>
</article>
