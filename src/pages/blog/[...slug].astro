---
import { render } from "astro:content";
import BlogPost from "../../components/BlogPost.astro";
import Layout from "../../components/Layout.astro";
import { SITE_TITLE } from "../../consts";
import { getVisiblePosts } from "../../utils/posts";
import { readingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = await getVisiblePosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} | ${SITE_TITLE}`}
  description={post.data.description}
  image={`/og/${post.id}.png`}
  article={{
    headline: post.data.title,
    publishedTime: post.data.pubDate,
    modifiedTime: post.data.updatedDate,
    section: post.data.category,
    tags: post.data.tags,
  }}
>
  <BlogPost {...post.data} minutesToRead={readingTime(post.body)}>
    <Content />
  </BlogPost>
</Layout>
