---
import Layout from "../../components/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { SITE_TITLE } from "../../consts";
import { getVisiblePosts } from "../../utils/posts";
import { readingTime } from "../../utils/readingTime";

const posts = await getVisiblePosts();
const description =
  "Reflexiones y proyectos personales sobre desarrollo web, infraestructura y programación en general.";
---

<Layout title={`Blog | ${SITE_TITLE}`} description={description}>
  <main class="content">
    <section class="mb-16 pb-8 border-b border-gray-300 dark:border-gray-700">
      <h1 class="mb-4 text-5xl md:text-6xl font-normal">Blog</h1>
      <p class="text-muted">{description}</p>
    </section>

    <section class="space-y-12">
      {
        posts.map((post) => (
          <PostCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            minutesToRead={readingTime(post.body)}
          />
        ))
      }
    </section>
  </main>
</Layout>
