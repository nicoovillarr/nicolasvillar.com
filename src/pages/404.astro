---
import Layout from "../components/Layout.astro";
import { getLang, localizePath, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout>
  <main
    class="content flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6"
  >
    <h1 class="text-4xl font-bold">{t("notFound.title")}</h1>
    <p>
      {t("notFound.back")} <a
        class="text-blue-700 hover:text-blue-900 hover:underline transition-colors dark:text-blue-400 dark:hover:text-blue-300"
        href={localizePath(lang)}>{t("notFound.home")}</a
      >.
    </p>
  </main>
</Layout>
