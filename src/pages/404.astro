    class="content flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6"
  >
    <h1 class="text-4xl font-bold">Parece que te perdiste...</h1>
    <p>
      Probá volviendo al <a
        class="text-purple-700 hover:text-purple-900 hover:underline transition-colors"
        href="/">inicio</a
      >.
    </p>
  </main>
</Layout>
