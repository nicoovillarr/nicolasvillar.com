---
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";
import PostCard from "../components/PostCard.astro";

const posts = (await getCollection("blog"))
  .filter((post) => post.data.enabled !== false)
  .sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
---

<Layout>
  <main class="content">
    <section class="mb-16 pb-8 border-b border-gray-300">
      <h1 class="mb-4 text-5xl md:text-6xl font-normal">Nicolás Villar</h1>
      <p class="text-muted text-lg">
        Reflexiones sobre tecnología, filosofía y el arte de vivir bien
      </p>
    </section>

    <section class="space-y-12">
      {
        posts.map((post) => (
          <PostCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            timeToRead={post.data.timeToRead}
            filePath={post.filePath}
          />
        ))
      }
    </section>
  </main>
</Layout>
